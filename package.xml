<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_llm_ui</name>
  <version>0.1.0</version>
  <description>LLM-driven natural language operator UI for the Ranger robot using Gradio and LangChain</description>
  <maintainer email="anh0001@example.com">Anh Nguyen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ranger_llm_msgs</depend>

  <!--
    Manipulation skills (Pick/Place/Handover/...) use
    manipulation_msgs/action/ExecuteSkill from the sibling MobileManipulationCore
    workspace (https://github.com/anh0001/MobileManipulationCore). It is overlaid
    at runtime, not built here, so it is intentionally NOT listed as an
    <exec_depend> (that would make `rosdep install` fail to resolve the key).
    Source the MobileManipulationCore install on top of this workspace to enable
    the manipulation tools; they degrade gracefully (and log a hint) if it is
    absent. Override the action name with EXECUTE_SKILL_ACTION if remapped.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
