# Ranger LLM UI Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider: openai, ollama, anthropic, or claude_code
# - openai/anthropic: pay-per-token API billing
# - ollama: local models, no cost
# - claude_code: Claude Pro/Max subscription via OAuth (no separate API billing)
LLM_PROVIDER=openai

# LLM Model (leave empty for provider default)
# OpenAI (recommended): gpt-4o-mini, gpt-4o, gpt-4.1-mini
# Note: this repo previously defaulted to `gpt-4`, which is expensive and may not qualify for some free tiers.
# Ollama: llama2, codellama, mistral, qwen2.5:32b, qwen3:latest
# Anthropic: claude-3-sonnet-20240229
# Claude Code (subscription): sonnet-4.6 (default), opus-4.7, haiku-4.5, sonnet-4
LLM_MODEL=sonnet-4.6

# Optional: cap completion length (reduces cost on long answers)
# LLM_MAX_TOKENS=512

# Optional: limit agent looping and history growth (reduces cost)
# ROSA_MAX_ITERATIONS=15
# ROSA_MAX_HISTORY_MESSAGES=20
# NOTE: When using camera tools, reduce history to avoid context overflow (images are large)
# Recommended with camera: ROSA_MAX_HISTORY_MESSAGES=6

# Optional: show token usage in chat responses
# SHOW_LLM_USAGE=true

# OpenAI API Key (required if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (required if using Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude Proxy (CLIProxyAPI) — recommended for Pro/Max subscription with full
# LangChain bind_tools() support. Provider name: claude_proxy
# Setup:
#   1) Download CLIProxyAPI from https://github.com/router-for-me/CLIProxyAPI/releases
#   2) Run `./cli-proxy-api -claude-login` and complete browser OAuth
#   3) Start the server: `./cli-proxy-api -config config.yaml` (default port 8317)
#   4) Point ranger-llm-ui at it via LLM_PROVIDER=claude_proxy
# CLAUDE_PROXY_BASE_URL=http://127.0.0.1:8317
# CLAUDE_PROXY_API_KEY=ranger-local-key

# Claude Code OAuth Token (required if LLM_PROVIDER=claude_code)
# Uses your Claude Pro/Max subscription instead of API billing.
# Setup:
#   1) npm install -g @anthropic-ai/claude-code
#   2) pip install langchain-claude-code   (needs Python 3.11+)
#   3) claude login                         (browser OAuth with Pro/Max account)
#   4) claude setup-token                   (prints long-lived token)
#   5) paste token below
# Falls back to ANTHROPIC_API_KEY if this is unset.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your_oauth_token_here

# Ollama Base URL (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# Gradio Server Configuration
GRADIO_PORT=7860

# Camera Configuration
# Camera topic (sensor_msgs/Image)
CAMERA_TOPIC=/camera/image_raw

# Camera Image Settings (for LLM token optimization)
# Reduce image resolution and use JPEG to minimize token usage
# Default 320x240 JPEG at quality=75 uses ~2,000-4,000 tokens per image
# (vs old default 640x480 PNG which used ~16,000-33,000 tokens)
CAMERA_IMAGE_MAX_WIDTH=320
CAMERA_IMAGE_MAX_HEIGHT=240
CAMERA_IMAGE_QUALITY=75
CAMERA_IMAGE_FORMAT=jpeg

# For different use cases:
# - Low quality (save tokens): 160x120, quality=50, format=jpeg (~500-1,000 tokens)
# - Default (RECOMMENDED): 320x240, quality=75, format=jpeg (~2,000-4,000 tokens)
# - High quality (more detail): 640x480, quality=85, format=jpeg (~8,000-12,000 tokens)
