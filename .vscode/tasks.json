{
    // All environment plumbing lives in scripts/dev.sh — these tasks are thin
    // wrappers so they stay readable and consistent. Run any of them from the
    // Command Palette: "Tasks: Run Task".
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "detail": "colcon build ranger_llm_msgs + ranger_llm_ui",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["build"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "Build: messages only",
            "detail": "colcon build only the ranger_llm_msgs action interfaces",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["build-msgs"],
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Clean build artifacts",
            "detail": "Remove build/ install/ log/",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["clean"],
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Run: simple (no ROS, no LLM)",
            "detail": "Fastest smoke test — SimpleAgent, no ROS 2, no LLM. UI at http://localhost:7860",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["run", "--simple"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "ranger-runtime" }
        },
        {
            "label": "Run: UI (pick provider, no ROS)",
            "detail": "Run the Gradio UI with a real LLM but no ROS 2 (tools simulated). Prompts for provider + model.",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["run", "--provider", "${input:provider}", "--model", "${input:model}"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "ranger-runtime" }
        },
        {
            "label": "Run: UI with ROS 2",
            "detail": "Build, then ros2 launch the UI with full ROS 2 integration.",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["run-ros"],
            "dependsOn": "Build",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "ranger-runtime" }
        },
        {
            "label": "Test (pytest)",
            "detail": "Run the pytest suite",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["test"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "CLIProxyAPI: start",
            "detail": "Start CLIProxyAPI on :8317 (Claude Pro/Max OAuth -> Anthropic HTTP). Set CLIPROXY_DIR if not in ~/tools/cliproxyapi.",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["proxy"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "ranger-runtime" }
        },
        {
            "label": "CLIProxyAPI: login (one-time)",
            "detail": "Authenticate CLIProxyAPI with your Claude Pro/Max subscription. Follow the printed SSH-tunnel + browser steps.",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["proxy-login"],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Run: UI (claude_proxy)",
            "detail": "Run the UI against CLIProxyAPI (provider=claude_proxy). Start 'CLIProxyAPI: start' first.",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/dev.sh",
            "args": ["run", "--provider", "claude_proxy", "--model", "${input:proxyModel}"],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "ranger-runtime" }
        },
        {
            "label": "Run: claude_proxy stack (proxy + UI)",
            "detail": "Start CLIProxyAPI and the UI side-by-side in dedicated panels.",
            "dependsOn": ["CLIProxyAPI: start", "Run: UI (claude_proxy)"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "provider",
            "type": "pickString",
            "description": "LLM provider",
            "default": "openai",
            "options": ["openai", "ollama", "anthropic", "claude_code", "claude_proxy"]
        },
        {
            "id": "model",
            "type": "promptString",
            "description": "Model name (leave blank for provider default; e.g. gpt-4o-mini, sonnet-4.6, opus)",
            "default": ""
        },
        {
            "id": "proxyModel",
            "type": "pickString",
            "description": "Claude (via CLIProxyAPI) model",
            "default": "sonnet-4.6",
            "options": ["sonnet-4.6", "sonnet-4.5", "opus-4.8", "opus-4.7", "opus", "haiku-4.5"]
        }
    ]
}
