{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch Ranger LLM UI",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "set -a && source .env && set +a && export PYTHONUSERBASE=\"/home/robofi/.local/ranger_llm_ui_py310\" && export PYTHONPATH=\"/home/robofi/.local/ranger_llm_ui_py310/lib/python3.10/site-packages:$PYTHONPATH\" && source ./install/setup.bash && ros2 launch ranger_llm_ui ranger_llm_ui.launch.py"
            ],
            "group": {
                "kind": "run",
                "isDefault": false
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Build with colcon",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "export PYTHONUSERBASE=\"/home/robofi/.local/ranger_llm_ui_py310\" && colcon build --packages-select ranger_llm_ui"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
